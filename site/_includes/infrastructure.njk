    link_name: Spokes' Response [PDF] # e.g. Spokes Response
    link_url: http://www.spokes.org.uk/wp-content/uploads/2025/03/2503-Spokes-Response_-Edinburgh-BioQuarter-Active-Travel-Gaps.pdf
