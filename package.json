{
  "dependencies": {
    "@supabase/supabase-js": "^2.38.2",
    "@11ty/eleventy": "^1.0.6",
    "netlify-cli": "^16.9.2"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "sass": "^1.87.0"
  },
  "scripts": {
    "watch:sass": "sass --watch site-css:_site/css",
    "build:sass": "sass site-css:_site/css",
    "watch:eleventy": "eleventy --serve",
    "build:eleventy": "eleventy",
    "start": "npm-run-all build:sass --parallel watch:*",
    "build": "npm-run-all build:*"
  }
}
